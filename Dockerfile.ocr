FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libmariadb-dev pkg-config libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN adduser --disabled-password --gecos '' appuser
WORKDIR /app
COPY requirements.txt requirements-ocr.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt -r requirements-ocr.txt
COPY . .
RUN mkdir -p /app/media /app/logs && chown -R appuser:appuser /app
USER appuser
CMD ["python", "manage.py", "process_receipt_ocr", "--loop", "--sleep", "2"]
