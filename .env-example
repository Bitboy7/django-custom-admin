# Django Core Configuration
SECRET_KEY=super_secret_key_change_in_production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://your-domain.com

# Cloudflare R2 (obligatorio cuando DEBUG=False)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=agricola-media
# Opcional: endpoint jurisdiccional; si se omite se construye con R2_ACCOUNT_ID
# R2_ENDPOINT_URL=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
# Vigencia en segundos de las URLs privadas firmadas
R2_SIGNED_URL_EXPIRE=3600

# Database Configuration
DB_NAME=agricola_costa_db
DB_USER=agricola_user
DB_PASSWORD=secure_password_here
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=root_password_here

# Security Configuration (for production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# AI Configuration (Optional)
GOOGLE_API_KEY=your_google_gemini_api_key
GOOGLE_API_MODEL=gemini-2.0-flash

# Email Configuration (Optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
