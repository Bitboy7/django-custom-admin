# Django Core Configuration
SECRET_KEY=super_secret_key_change_in_production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://your-domain.com

# Cloudflare R2 (obligatorio cuando DEBUG=False)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=agricola-media
# Opcional: endpoint jurisdiccional; si se omite se construye con R2_ACCOUNT_ID
# R2_ENDPOINT_URL=https://ACCOUNT_ID.eu.r2.cloudflarestorage.com
# Vigencia en segundos de las URLs privadas firmadas
R2_SIGNED_URL_EXPIRE=3600

# Database Configuration
DB_NAME=agricola_costa_db
DB_USER=agricola_user
DB_PASSWORD=secure_password_here
DB_HOST=db
DB_PORT=3306
DB_ROOT_PASSWORD=root_password_here

# Security Configuration (for production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# AI Configuration (Optional)
GOOGLE_API_KEY=your_google_gemini_api_key
GOOGLE_API_MODEL=gemini-2.0-flash

# Email Configuration (Optional)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# MCP report server (solo lectura) � ver mcp_server/README.md
MCP_DB_HOST=127.0.0.1
MCP_DB_PORT=3306
MCP_DB_NAME=agricola_costa_db
MCP_DB_USER=mcp_readonly
MCP_DB_PASSWORD=change_me_long_random
MCP_MAX_ROWS=500
MCP_QUERY_TIMEOUT_MS=10000
# HTTP (solo si usas --transport http)
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
MCP_HTTP_TOKEN=change_me_32_chars_minimum
# Nunca en producci�n con datos reales:
MCP_ALLOW_NO_AUTH=false

# OpenAI (recomendado para el asistente MCP)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
# Forzar proveedor: openai | google | openrouter (opcional)
# AI_PROVIDER=openai
# Opcional: sobreescribe precios (USD por 1M tokens)
# AI_PRICE_INPUT_PER_MTOK=0.20
# AI_PRICE_OUTPUT_PER_MTOK=1.20
